# Copy this file to .env and fill in real values. .env is never committed.

# --- App inbox (Gmail with 2-Step Verification + App Password) ---
INBOX_EMAIL=your.app.inbox@gmail.com
INBOX_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Claude API (milestone 3) ---
ANTHROPIC_API_KEY=

# --- Contact details used in Anfragen, per profile ---
NEWFRESHHORIZONX_EMAIL=
NEWFRESHHORIZONX_PHONE=
SOUISSINEBILAI_EMAIL=
SOUISSINEBILAI_PHONE=

# --- Cloud (Vercel). Set these in Vercel → Settings → Environment Variables ---
# Postgres connection string; added automatically when you connect Neon in Vercel.
# Leave empty locally to use the SQLite file in data/.
DATABASE_URL=
# The one password both of you type on the login page
APP_PASSWORD=
# Random string; the same value goes into GitHub → Settings → Secrets → IMPORT_SECRET
IMPORT_SECRET=
